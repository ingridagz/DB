																"type": "MULTI_LINE_EDITOR",
																"function": "const ownFunds = model.workPlaces[row.parent.index]?.workPlaceEstimates[row.index]?.expenceOwnFunds;\nconst totalCost = model.workPlaces[row.parent.index]?.workPlaceEstimates[row.index]?.expenceFunds;\n\nif (!ownFunds || !totalCost) {\n return 0;   \n}\n\nconst ownFundsPercent = (ownFunds * 100 / totalCost);\n\nif (ownFundsPercent < 0) {\n    return 0;   \n}\n\nreturn ownFundsPercent.toFixed(2);"
