								"dataModelValue": {
									"expression": {
										"type": "MULTI_LINE_EDITOR",
										"function": "const subsidies = model.totalAmountOfSubsidies;\n\nconst totalCost = model.totalFunds;\n\nif (!subsidies || !totalCost) {\n return 0;   \n}\n\nconst subsidiesPercent = (subsidies * 100 / totalCost);\n\nif (subsidiesPercent < 0 || isNaN(subsidiesPercent)) {\n    return 0;   \n}\n\nreturn subsidiesPercent.toFixed(2);"
									},
									"calculationType": "AFTER_CHANGE"
